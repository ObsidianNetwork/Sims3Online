# Sims3Online environment variables (all optional; SIMSONLINE_* names kept for compatibility).
# Nothing loads a .env file automatically: export these in the shell that runs
# scripts/stackctl.py or the controllers. Empty values use the defaults shown.

# Path to TS3W.exe (default: C:\Program Files (x86)\The Sims 3\Game\Bin\TS3W.exe)
# Example: C:\Games\The Sims 3\Game\Bin\TS3W.exe
SIMSONLINE_TS3_PATH=

# Loopback admin (bridgectl) ports that scripts/stackctl.py gives each controller.
# These run raw bridge commands inside the game; they only accept loopback addresses.
SIMSONLINE_SERVER_BRIDGECTL=127.0.0.1:34029
SIMSONLINE_CLIENT_BRIDGECTL=127.0.0.1:34030
SIMSONLINE_CLIENT2_BRIDGECTL=127.0.0.1:34031

# SimLink sidecar (shared-memory rings). Set to 1 to enable. Needs the sidecar
# installed (python scripts/sidecar.py install), an ASI loader in Game\Bin, and
# the Steam 1.67.2.024037 TS3W.exe build. See SimLink/README.md.
SIMSONLINE_SIMLINK_SHADOW=0
SIMSONLINE_SIMLINK_CLIENT_RING=0
SIMSONLINE_SIMLINK_SERVER_RING=0

# Error reporting (optional). An empty DSN turns Sentry off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

