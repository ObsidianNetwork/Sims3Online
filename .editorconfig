# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# C# source files
[*.cs]
indent_style = space
indent_size = 4

# Python files
[*.py]
indent_style = space
indent_size = 4

# Web / configuration / docs
[*.{json,yml,yaml,xml,props,targets,csproj,sln}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows script files (stored with LF like everything else)
[*.{ps1,bat,cmd}]
indent_style = space
indent_size = 4
